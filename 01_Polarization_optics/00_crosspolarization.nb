Cell[CellGroupData[{

Cell["\<\
Open questions on arbitrary polarization


Question: Is J1(\[Theta]1,\[Eta]1).J2(\[Theta]2,\[Eta]2) the same \
mathematical form as J(\[Theta]eff,\[Eta]eff), and thus \[Theta]eff = f(\
\[Theta]1,\[Theta]2) and \[Eta](eff) = g(\[Eta]1,\[Eta]2)?
Answer: No answer yet. Expectation: yes, if the general Jones matrix \
describes an arbitrary unitary, the product of two Jones matrices is also a \
unitary. Caveat: I\[CloseCurlyQuote]ve hard set the circularity of the Jones \
matrix to 0, which might compromise the above. Although I don\
\[CloseCurlyQuote]t think so if for all the element the circularity is zero \
(so the polarization elements have eigenvectors that are linearly polarized, \
rather than circularly polarized)\
\>", "Section",
 CellChangeTimes->{{3.970711622145623*^9, 3.970711634313609*^9}, {
  3.9708034571386757`*^9, 3.970803567832314*^9}, {3.970803680794917*^9, 
  3.970803686106564*^9}, {3.9708037545577517`*^9, 3.9708038791456423`*^9}, {
  3.9708042791555967`*^9, 
  3.970804284723652*^9}},ExpressionUUID->"bcb26446-d45e-400a-b5db-\
18e0bd85a274"],

Cell["\<\
Definition of polarization matrices. General non-circular phase retardation \
Jones matrix (J), Jones matrix for phase retardation of element 1 (J1), Jones \
matrix of phase retardation element 2 (J2), Jones matrix for a pass through \
first element 1 and then element 2 (Jforward), Jones matrix for passing back \
through element 2 and then element 1 after a reflection (Jbackward). \
\>", "Text",
 CellChangeTimes->{{3.970718544420217*^9, 
  3.970718689885817*^9}},ExpressionUUID->"bbb583ca-3f89-4bfa-b629-\
2e4dd05f916b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"\[Theta]_", ",", "\[Eta]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      FractionBox["\[Eta]", "2"]}], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "+", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}], "]"}]}], ")"}], 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}], "]"}]}], ")"}], 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], "+", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], "}"}]}], 
     "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J1", "[", 
    RowBox[{"\[Theta]1_", ",", "\[Eta]1_"}], "]"}], " ", "=", " ", 
   RowBox[{"J", "[", 
    RowBox[{"\[Theta]1", ",", "\[Eta]1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J2", "[", 
    RowBox[{"\[Theta]2_", ",", "\[Eta]2_"}], "]"}], " ", "=", " ", 
   RowBox[{"J", "[", 
    RowBox[{"\[Theta]2", ",", "\[Eta]2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Jforward", "[", 
    RowBox[{
    "\[Theta]1_", ",", "\[Eta]1_", ",", "\[Theta]2_", ",", "\[Eta]2_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"J2", "[", 
      RowBox[{"\[Theta]2", ",", "\[Eta]2"}], "]"}], ".", 
     RowBox[{"J1", "[", 
      RowBox[{"\[Theta]1", ",", "\[Eta]1"}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Jbackward", "[", 
    RowBox[{
    "\[Theta]1_", ",", "\[Eta]1_", ",", "\[Theta]2_", ",", "\[Eta]2_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"J1", "[", 
      RowBox[{
       RowBox[{"-", "\[Theta]1"}], ",", "\[Eta]1"}], "]"}], ".", 
     RowBox[{"J2", "[", 
      RowBox[{
       RowBox[{"-", "\[Theta]2"}], ",", "\[Eta]2"}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.970711853586514*^9, 3.970711965466753*^9}, {
  3.970712031410838*^9, 3.970712103745713*^9}, {3.970712163278542*^9, 
  3.970712265303133*^9}, {3.970712317446417*^9, 3.9707123188362303`*^9}, {
