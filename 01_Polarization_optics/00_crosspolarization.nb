Cell[CellGroupData[{

Cell["\<\
Including arbitrary rotations in the waveguide

Definition of polarization through the \
\[OpenCurlyQuote]Polarizer-HWP-QWP-fiber-Defect\[CloseCurlyQuote] system, \
taking into account reflections. We define three polarizations:
- Polarization of the excitation light at the defect
- Polarization of the reflected excitation light just before the polarizer
- Polarization of the emitted light by the defect just before the polarizer\
\>", "Section",
 CellChangeTimes->{{3.9714161411257687`*^9, 
  3.971416178972773*^9}},ExpressionUUID->"35876574-48b4-4f37-83b0-\
374ac2bb21cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolExcFiberWave", "[", 
    RowBox[{
    "\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", 
     "\[Theta]fiber_", ",", "\[Eta]fiber_", ",", "\[Theta]wave_", ",", 
     "\[Eta]wave_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{"Jgen", "[", 
     RowBox[{"\[Theta]wave", ",", "\[Eta]wave"}], "]"}], ".", 
    RowBox[{"Jgen", "[", 
     RowBox[{"\[Theta]fiber", ",", "\[Eta]fiber"}], "]"}], ".", 
    RowBox[{"Jqwp", "[", "\[Theta]qwp", "]"}], ".", 
    RowBox[{"Jhwp", "[", "\[Theta]hwp", "]"}], ".", 
    RowBox[{"InputPol", "[", "\[Theta]input", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolExcRefFiberWave", "[", 
    RowBox[{
    "\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", 
     "\[Theta]fiber_", ",", "\[Eta]fiber_"}], "]"}], " ", "=", "  ", 
   RowBox[{
    RowBox[{"Jhwp", "[", 
     RowBox[{"-", "\[Theta]hwp"}], "]"}], ".", 
    RowBox[{"Jqwp", "[", 
     RowBox[{"-", "\[Theta]qwp"}], "]"}], ".", " ", 
    RowBox[{"Jgen", "[", 
     RowBox[{
      RowBox[{"-", "\[Theta]fiber"}], ",", "\[Eta]fiber"}], "]"}], ".", 
    "Jref", ".", " ", 
    RowBox[{"Jgen", "[", 
     RowBox[{"\[Theta]fiber", ",", "\[Eta]fiber"}], "]"}], ".", 
    RowBox[{"Jqwp", "[", "\[Theta]qwp", "]"}], ".", 
    RowBox[{"Jhwp", "[", "\[Theta]hwp", "]"}], ".", 
    RowBox[{"InputPol", "[", "\[Theta]input", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolEmiFiberWave", "[", 
    RowBox[{
    "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", "\[Theta]fiber_", ",", 
