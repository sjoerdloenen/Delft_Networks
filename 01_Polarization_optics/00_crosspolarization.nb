Cell[CellGroupData[{

Cell["\<\
Calculate polarization overlap/projection of:
- Excitation light at the defect position with the defect
- Reflected excitation light at the polarizer with the polarizer
- Emitted defect light at the polarizer with the polarizer
We take the angle of the polarizer the same as the angle of the input \
polarization (which makes sense)\
\>", "Section",
 CellChangeTimes->{{3.970299424138831*^9, 3.970299521415463*^9}, {
  3.970299876673645*^9, 
  3.97029989850532*^9}},ExpressionUUID->"306da99f-e081-4aca-8180-\
9d4540e8b680"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ProjExcFiberWaveDef", "[", 
    RowBox[{
    "\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", 
     "\[Theta]fiber_", ",", "\[Eta]fiber_", ",", "\[Theta]wave_", ",", 
     "\[Eta]wave_"}], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{"DefectPol", ".", 
      RowBox[{"PolExcFiberWave", "[", 
       RowBox[{
       "\[Theta]input", ",", "\[Theta]hwp", ",", "\[Theta]qwp", ",", 
        "\[Theta]fiber", ",", "\[Eta]fiber", ",", "\[Theta]wave", ",", 
        "\[Eta]wave"}], "]"}]}], "]"}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProjExcRefFiberWavePol", "[", 
    RowBox[{
    "\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", 
     "\[Theta]fiber_", ",", "\[Eta]fiber_"}], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"Polarizer", "[", 
       RowBox[{"-", "\[Theta]input"}], "]"}], ".", 
      RowBox[{"PolExcRefFiberWave", "[", 
       RowBox[{
       "\[Theta]input", ",", "\[Theta]hwp", ",", "\[Theta]qwp", ",", 
        "\[Theta]fiber", ",", "\[Eta]fiber"}], "]"}]}], "]"}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProjEmiFiberWaveDef", "[", 
    RowBox[{
    "\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_", ",", 
     "\[Theta]fiber_", ",", "\[Eta]fiber_", ",", "\[Theta]wave_", ",", 
     "\[Eta]wave_"}], "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"Polarizer", "[", 
       RowBox[{"-", "\[Theta]input"}], "]"}], ".", 
      RowBox[{"PolEmiFiberWave", "[", 
       RowBox[{
       "\[Theta]hwp", ",", "\[Theta]qwp", ",", "\[Theta]fiber", ",", 
        "\[Eta]fiber", ",", "\[Theta]wave", ",", "\[Eta]wave"}], "]"}]}], 
     "]"}], "2"]}], ";"}]}], "Input",
