Cell[CellGroupData[{

Cell["\<\
Definition of polarization through the \
\[OpenCurlyQuote]Polarizer-HWP-QWP-Defect\[CloseCurlyQuote] system, taking \
into account reflections. We define three polarizations:
- Polarization of the excitation light at the defect
- Polarization of the reflected excitation light just before the polarizer
- Polarization of the emitted light by the defect just before the polarizer\
\>", "Section",
 CellChangeTimes->{{3.9702993002446747`*^9, 3.970299412954071*^9}, {
  3.970804389153343*^9, 
  3.970804393414263*^9}},ExpressionUUID->"e80e6496-e26d-495a-9e9c-\
83b4eda401bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolExc", "[", 
    RowBox[{"\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_"}], 
    "]"}], " ", "=", 
   RowBox[{
    RowBox[{"Jqwp", "[", "\[Theta]qwp", "]"}], ".", 
    RowBox[{"Jhwp", "[", "\[Theta]hwp", "]"}], ".", 
    RowBox[{"InputPol", "[", "\[Theta]input", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolExcRef", "[", 
    RowBox[{"\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_"}], 
    "]"}], " ", "=", "  ", 
   RowBox[{
    RowBox[{"Jhwp", "[", 
     RowBox[{"-", "\[Theta]hwp"}], "]"}], ".", 
    RowBox[{"Jqwp", "[", 
     RowBox[{"-", "\[Theta]qwp"}], "]"}], ".", " ", "Jref", ".", " ", 
    RowBox[{"PolExc", "[", 
     RowBox[{"\[Theta]input", ",", "\[Theta]hwp", ",", "\[Theta]qwp"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolEmi", "[", 
    RowBox[{"\[Theta]hwp_", ",", "\[Theta]qwp_"}], "]"}], " ", "=", "  ", 
   RowBox[{
    RowBox[{"Jhwp", "[", 
     RowBox[{"-", "\[Theta]hwp"}], "]"}], ".", 
    RowBox[{"Jqwp", "[", 
     RowBox[{"-", "\[Theta]qwp"}], "]"}], " ", ".", "Jref", ".", " ", 
    "DefectPol"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.970298385505439*^9, 3.970298413275775*^9}, {
  3.970298632120223*^9, 3.970298868995019*^9}, {3.9702989722946997`*^9, 
  3.970298974493485*^9}, {3.970299218249023*^9, 3.9702992346964073`*^9}, {
  3.970299718607622*^9, 3.970299719723055*^9}, {3.970300153120397*^9, 
  3.970300181577363*^9}, {3.970301974420189*^9, 3.970301979043145*^9}, {
  3.970302522182332*^9, 3.9703025236807137`*^9}, {3.970302790311277*^9, 
  3.9703027915721807`*^9}, {3.9703029613493557`*^9, 3.970302962316945*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"c8860a38-b6b9-46d4-a6d8-2bf397844948"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Calculate polarization overlap/projection of:
- Excitation light at the defect position with the defect
- Reflected excitation light at the polarizer with the polarizer
- Emitted defect light at the polarizer with the polarizer
We take the angle of the polarizer the same as the angle of the input \
polarization (which makes sense)\
\>", "Section",
 CellChangeTimes->{{3.970299424138831*^9, 3.970299521415463*^9}, {
  3.970299876673645*^9, 3.97029989850532*^9}, {3.970804378484951*^9, 
  3.9708043810691566`*^9}},ExpressionUUID->"228cb947-f6ae-4ea7-bb21-\
cac0ccaf8f06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ProjExcDef", "[", 
    RowBox[{"\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_"}], 
    "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{"DefectPol", ".", 
      RowBox[{"PolExc", "[", 
       RowBox[{"\[Theta]input", ",", "\[Theta]hwp", ",", "\[Theta]qwp"}], 
       "]"}]}], "]"}], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProjExcRefPol", "[", 
    RowBox[{"\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_"}], 
    "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"Polarizer", "[", 
       RowBox[{"-", "\[Theta]input"}], "]"}], ".", 
      RowBox[{"PolExcRef", "[", 
       RowBox[{"\[Theta]input", ",", "\[Theta]hwp", ",", "\[Theta]qwp"}], 
       "]"}]}], "]"}], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProjEmiPol", "[", 
    RowBox[{"\[Theta]input_", ",", "\[Theta]hwp_", ",", "\[Theta]qwp_"}], 
    "]"}], "=", 
   SuperscriptBox[
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"Polarizer", "[", 
       RowBox[{"-", "\[Theta]input"}], "]"}], ".", 
      RowBox[{"PolEmi", "[", 
       RowBox[{"\[Theta]hwp", ",", "\[Theta]qwp"}], "]"}]}], "]"}], "2"]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.970299523951239*^9, 3.97029952920584*^9}, {
  3.970299600344474*^9, 3.97029967330335*^9}, {3.970299705376305*^9, 
  3.970299749776194*^9}, {3.970299798879364*^9, 3.9702998001871977`*^9}, {
  3.970299847641366*^9, 3.9702998701695232`*^9}, {3.970300047492362*^9, 
  3.97030007843548*^9}, {3.9703001895787582`*^9, 3.970300195065648*^9}, {
  3.970301708128212*^9, 3.970301767784985*^9}, {3.970301985121194*^9, 
  3.970301990340048*^9}, {3.970304133166533*^9, 3.970304147963997*^9}, {
  3.970804611331524*^9, 3.970804626150195*^9}, {3.9708046870092373`*^9, 
  3.970804691950058*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"f5306c7f-1bcc-42f9-829c-89ff7c87e43b"],

