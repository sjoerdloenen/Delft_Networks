   3.9702983257264233`*^9, 3.970298330586709*^9}, {3.970298367830574*^9, 
   3.970298388919469*^9}, {3.97029846141358*^9, 3.970298542579734*^9}, {
   3.97029891569938*^9, 3.9702989358438597`*^9}, {3.970300716944124*^9, 
   3.970300757843172*^9}, {3.970301583492559*^9, 3.970301600549856*^9}, 
   3.970302957428433*^9, {3.970634400319323*^9, 3.9706344028749523`*^9}, {
   3.970804102903078*^9, 3.9708041130309963`*^9}, {3.970804160913686*^9, 
   3.97080416204844*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"f00f3842-8832-4c0d-95ec-bd947e2ea7e2"]
