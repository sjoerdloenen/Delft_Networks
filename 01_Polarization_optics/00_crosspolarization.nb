Cell[CellGroupData[{

Cell["\<\
Forward pass + reflection + backwards reflection 
- Question: If you pass through a polarization element with an arbitrary \
angle and retardation, reflect and pass back through that same element, can \
the total effect of this be described by the same Jones matrix as the \
polarization element, but with double the retardation? 
- Answer: Yes (note, for sticking to the same reference frame of forward \
propagating light, I\[CloseCurlyQuote]ve included another reflection after \
the backwards pass.\
\>", "Section",
 CellChangeTimes->{{3.970803577572708*^9, 
  3.970803748509197*^9}},ExpressionUUID->"311ed0ff-bb66-46d4-b584-\
4620df96692c"],

Cell["\<\
Investigating whether a forward pass + reflection + backwards pass through a \
polarization element with a general angle and phase retardation can be \
described by a combined single general Jones matrix of the same form as the \
Jones matrix of the component itself \[LineSeparator]
Answer: Yes, as seen from the manipulate plot, for an arbitrary angle \
\[Theta] and arbitrary phase \[Eta], the reflection matrix and the \
combination matrix are the same. Note that here this is only shown for the \
[[1,1]] element of the matrices, but I\[CloseCurlyQuote]ve checked this as \
well for the three other matrix elements.\
\>", "Text",
 CellChangeTimes->{{3.9707187084187393`*^9, 3.9707187776263933`*^9}, {
  3.970719224128868*^9, 3.970719259398684*^9}, {3.9707194286001587`*^9, 
  3.970719459878559*^9}},ExpressionUUID->"dd1c472f-c2ad-4a0d-859c-\
407cb0e018b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reflMat", "[", 
    RowBox[{"\[Theta]_", ",", "\[Eta]_"}], "]"}], " ", "=", 
   RowBox[{"Jref", ".", 
    RowBox[{"J", "[", 
     RowBox[{
      RowBox[{"-", "\[Theta]"}], ",", "\[Eta]"}], "]"}], ".", "Jref", ".", 
    RowBox[{"J", "[", 
     RowBox[{"\[Theta]", ",", "\[Eta]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"combMat", "[", 
    RowBox[{"\[Theta]_", ",", "\[Eta]_"}], "]"}], " ", "=", " ", 
   RowBox[{"J", "[", 
    RowBox[{"\[Theta]", ",", 
     RowBox[{"2", "\[Eta]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.970717571599025*^9, 3.970717715650702*^9}, {
  3.970717746674136*^9, 3.970717748364312*^9}, {3.970718232419815*^9, 
  3.9707182342246733`*^9}, {3.970718513271276*^9, 3.97071851389075*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"fc8af733-35ee-4a96-aaef-0dc04e74ed7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"refMatEl", "[", 
    RowBox[{"\[Theta]_", ",", "\[Eta]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"reflMat", "[", 
     RowBox[{"\[Theta]", ",", "\[Eta]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"combMatEl", "[", 
    RowBox[{"\[Theta]_", ",", "\[Eta]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"combMat", "[", 
     RowBox[{"\[Theta]", ",", "\[Eta]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"refMatEl", "[", 
             RowBox[{
              RowBox[{"\[Theta]input", "*", "\[Pi]"}], ",", 
              RowBox[{"\[Eta]", "*", "\[Pi]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Re", "[", 
            RowBox[{"combMatEl", "[", 
             RowBox[{
              RowBox[{"\[Theta]input", "*", "\[Pi]"}], ",", 
              RowBox[{"\[Eta]", "*", "\[Pi]"}]}], "]"}], "]"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"\[Theta]input", ",", "0", ",", "2"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.1"}], ",", "1.1"}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<reflection\>\"", ",", "\"\<combination\>\""}], 
           "}"}]}], ",", " ", 
         RowBox[{"Frame", "->", " ", "True"}], ",", " ", 
         RowBox[{"ImageSize", "->", "500"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Theta]input (\[Pi])\>\"", ",", "\"\<Real part\>\""}], 
           "}"}]}]}], "\[IndentingNewLine]", "]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Im", "[", 
            RowBox[{"refMatEl", "[", 
             RowBox[{
              RowBox[{"\[Theta]input", "*", "\[Pi]"}], ",", 
              RowBox[{"\[Eta]", "*", "\[Pi]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Im", "[", 
            RowBox[{"combMatEl", "[", 
             RowBox[{
              RowBox[{"\[Theta]input", "*", "\[Pi]"}], ",", 
              RowBox[{"\[Eta]", "*", "\[Pi]"}]}], "]"}], "]"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"\[Theta]input", ",", "0", ",", "2"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.1"}], ",", "1.1"}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<reflection\>\"", ",", "\"\<combination\>\""}], 
           "}"}]}], ",", " ", 
         RowBox[{"Frame", "->", " ", "True"}], ",", " ", 
         RowBox[{"ImageSize", "->", "500"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Theta]input (\[Pi])\>\"", ",", "\"\<Imaginary part\>\""}], 
           "}"}]}]}], "]"}], "}"}]}], "}"}], "\[IndentingNewLine]", "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "0", ",", "\"\<\[Eta]\>\""}], "}"}], ",", "0", 
     ",", "2", ",", 
     RowBox[{"Appearance", " ", "->", " ", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.970717775626649*^9, 3.9707178050616283`*^9}, {
  3.970717838040126*^9, 3.9707180610563307`*^9}, {3.970718828550209*^9, 
