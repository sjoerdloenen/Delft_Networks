Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Below the integral definitions of the x- and z-magnetic field directions \
generated by a stripline of width \[OpenCurlyDoubleQuote]w\
\[CloseCurlyDoubleQuote] centered at position \[OpenCurlyDoubleQuote]xs\
\[CloseCurlyDoubleQuote].\[LineSeparator]Note: In defining the argument of \
the ArcTan, I took care here that the ArcTan function can only output from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[Pi]", "2"]}], ",", " ", 
     FractionBox["\[Pi]", "2"]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6adac96-7fa0-46d1-bc7f-05ea8cfdc41d"],
 ". Correspondingly, this means that these functions are only valid for z<0 \
(meaning you\[CloseCurlyQuote]re looking at the magnetic fields below the \
stripline)."
}], "Section",
 CellChangeTimes->{{3.951892570431464*^9, 3.9518926403964252`*^9}, {
  3.951892687638425*^9, 
  3.951892799097034*^9}},ExpressionUUID->"a8c68614-e155-4e34-aa88-\
fefa3c05c79a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Mu]0", ">", "0"}], ",", " ", 
     RowBox[{"J", ">", "0"}], ",", 
     RowBox[{"w", ">", "0"}], ",", 
     RowBox[{"z", "<", "0"}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "z", ",", "w"}], "}"}], ",", "Reals"}], "]"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bx", "[", 
   RowBox[{"x_", ",", "z_", ",", "w_"}], "]"}], " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[Mu]0", " ", "J"}], 
      RowBox[{"2", "\[Pi]", " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "xs"}], ")"}], "2"], "+", 
         SuperscriptBox["z", "2"]}]]}]], 
     RowBox[{"Cos", "[", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "xs"}], ")"}], 
        RowBox[{"-", "z"}]], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"xs", ",", 
      RowBox[{"-", 
       FractionBox["w", "2"]}], ",", 
      FractionBox["w", "2"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bz", "[", 
   RowBox[{"x_", ",", "z_", ",", "w_"}], "]"}], " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[Mu]0", " ", "J"}], 
      RowBox[{"2", "\[Pi]", " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "xs"}], ")"}], "2"], "+", 
         SuperscriptBox["z", "2"]}]]}]], 
     RowBox[{"Sin", "[", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "xs"}], ")"}], 
        RowBox[{"-", "z"}]], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"xs", ",", 
      RowBox[{"-", 
       FractionBox["w", "2"]}], ",", 
      FractionBox["w", "2"]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.949674925498562*^9, 3.94967508328806*^9}, {
   3.949675128537416*^9, 3.9496751511383953`*^9}, {3.949675192559436*^9, 
   3.949675211368985*^9}, {3.949675244538435*^9, 3.949675245007711*^9}, {
   3.949676515748774*^9, 3.94967651747357*^9}, {3.949676576091551*^9, 
   3.949676576540277*^9}, {3.9497181947776747`*^9, 3.949718196651383*^9}, {
   3.949718390719738*^9, 3.949718396698288*^9}, {3.949718519148765*^9, 
   3.949718524943388*^9}, {3.94971890204814*^9, 3.949718913569532*^9}, 
   3.94971943084886*^9, {3.949981209436331*^9, 3.949981214145495*^9}, {
   3.949981249940524*^9, 3.949981251586864*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"051bf3ac-5d66-4506-a719-b34ed4e48b29"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"J", " ", "\[Mu]0", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ArcCot", "[", 
       FractionBox[
        RowBox[{"2", " ", "z"}], 
        RowBox[{"w", "-", 
         RowBox[{"2", " ", "x"}]}]], "]"}], "+", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{
         FractionBox["w", "2"], "+", "x"}], "z"], "]"}]}], ")"}]}], 
   RowBox[{"2", " ", "\[Pi]"}]]}]], "Output",
 CellChangeTimes->{
  3.949675153404408*^9, 3.94967521250961*^9, 3.949675246209696*^9, 
   3.949676518111446*^9, 3.9496765978865633`*^9, 3.9497181971046553`*^9, 
   3.949718397177187*^9, 3.9497185260434847`*^9, 3.9497189173362627`*^9, 
   3.9497251715557823`*^9, 3.949737846021145*^9, {3.949981217891398*^9, 
   3.949981261121498*^9}, 3.951892536168915*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"d73101ad-16d5-4729-adc2-8943aca750a3"],

Cell[BoxData[
 FractionBox[
  RowBox[{"J", " ", "\[Mu]0", " ", 
   RowBox[{"Log", "[", 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{"8", " ", "w", " ", "x"}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"w", "-", 
          RowBox[{"2", " ", "x"}]}], ")"}], "2"], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["z", "2"]}]}]]}], "]"}]}], 
  RowBox[{"4", " ", "\[Pi]"}]]], "Output",
 CellChangeTimes->{
  3.949675153404408*^9, 3.94967521250961*^9, 3.949675246209696*^9, 
   3.949676518111446*^9, 3.9496765978865633`*^9, 3.9497181971046553`*^9, 
   3.949718397177187*^9, 3.9497185260434847`*^9, 3.9497189173362627`*^9, 
   3.9497251715557823`*^9, 3.949737846021145*^9, {3.949981217891398*^9, 
   3.949981261121498*^9}, 3.9518925376024857`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"82496a63-1ac5-4cb4-9d42-188771de0849"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Magnetic field at position \[OpenCurlyDoubleQuote]x\[CloseCurlyDoubleQuote] \
from the center of the stripline at a position \[OpenCurlyDoubleQuote]z\
\[CloseCurlyDoubleQuote] below the stripline (z can be manipulated). The \
stripline width can be manipulated and is indicated with a red bar.\
\>", "Section",
 CellChangeTimes->{{3.9518928397672377`*^9, 
  3.951892911860105*^9}},ExpressionUUID->"60d70206-5c31-48ca-9208-\
f2020bef8d7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["\[Mu]", 
    RowBox[{"0", "val"}]], "=", 
   RowBox[{"4", "\[Pi]", "*", "1*^-7"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mTconv", " ", "=", " ", "1*^3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"umconv", " ", "=", " ", "1*^6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stripline", "[", "w_", "]"}], " ", "=", " ", 
   RowBox[{"Line", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["w", "2"]}], ",", "0.1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["w", "2"], ",", "0.1"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LineStylesl", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Thick", ",", "Red"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"mTconv", "*", 
           RowBox[{"Bx", "[", 
            RowBox[{
             FractionBox["x", "umconv"], ",", 
             FractionBox["z", "umconv"], ",", 
             FractionBox["w", "umconv"]}], "]"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Mu]0", "->", 
             SubscriptBox["\[Mu]", 
              RowBox[{"0", "val"}]]}], ",", " ", 
            RowBox[{"J", "->", 
             FractionBox["1", 
              FractionBox["w", "umconv"]]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "30"}], ",", "30"}], "}"}], ",", " ", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", "LineStylesl", "]"}], ",", 
            RowBox[{"stripline", "[", "w", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "20"}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x (\[Upsilon]m)\>\"", ",", "\"\<Bx (mT)\>\""}], 
           "}"}]}], ",", " ", 
         RowBox[{"ImageSize", "->", "300"}]}], "\[IndentingNewLine]", "]"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"mTconv", "*", 
           RowBox[{"Bz", "[", 
            RowBox[{
             FractionBox["x", "umconv"], ",", 
             FractionBox["z", "umconv"], ",", 
             FractionBox["w", "umconv"]}], "]"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Mu]0", "->", 
             SubscriptBox["\[Mu]", 
              RowBox[{"0", "val"}]]}], ",", " ", 
            RowBox[{"J", "->", 
             FractionBox["1", 
              FractionBox["w", "umconv"]]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "30"}], ",", "30"}], "}"}], ",", " ", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", "LineStylesl", "]"}], ",", 
            RowBox[{"stripline", "[", "w", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "20"}], ",", "20"}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x (\[Upsilon]m)\>\"", ",", "\"\<Bz (mT)\>\""}], 
           "}"}]}], ",", " ", 
         RowBox[{"ImageSize", "->", "300"}]}], "\[IndentingNewLine]", "]"}], 
       "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{"-", "10*^-6"}], "*", "umconv"}], ",", "\"\<z\>\""}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"-", "1*^-9"}], "*", "umconv"}], ",", 
     RowBox[{
      RowBox[{"-", "30*^-6"}], "*", "umconv"}], ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", ",", 
       RowBox[{"1*^-6", "*", "umconv"}], ",", 
       "\"\<\!\(\*SubscriptBox[\(w\), \(stripline\)]\)\>\""}], "}"}], ",", 
     RowBox[{"1*^-9", "*", "umconv"}], ",", 
     RowBox[{"30*^-6", "*", "umconv"}], ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]}], "Input",
